        "bottom_left_corner": [-180.0, 310.0],
        "top_edge_midpoint": [-90.0, 0.0],
        "screen_center": [-90.0, 155.0]
      }
    }
  },
  "calibration_inputs": {
    "intrinsics_file": "python/calibration/output/intrinsics.json",
